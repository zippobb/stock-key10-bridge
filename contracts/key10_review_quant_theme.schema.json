{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Key10 simplified final review",
  "type": "object",
  "required": [
    "review_contract_version",
    "schema_version",
    "model_version",
    "stage",
    "input_stage",
    "trade_date",
    "next_trade_date",
    "evidence_cutoff",
    "future_data_rows_used",
    "input_sha256",
    "attempt_no",
    "market_context",
    "official_candidates",
    "external_candidates"
  ],
  "properties": {
    "review_contract_version": {
      "const": "quant_theme_rotation_20260927"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "model_version": {
      "const": "V2.0"
    },
    "stage": {
      "const": "final_review"
    },
    "input_stage": {
      "const": "21:30_quantitative_review_payload"
    },
    "trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "next_trade_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "evidence_cutoff": {
      "type": "string",
      "minLength": 20
    },
    "future_data_rows_used": {
      "const": 0,
      "type": "integer"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt_no": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "market_context": {
      "type": "object",
      "required": [
        "reported_facts",
        "analysis_inferences",
        "missing",
        "decision"
      ],
      "properties": {
        "reported_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "summary",
              "source"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "required": [
                  "url",
                  "published_at"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "published_at": {
                    "type": "string",
                    "minLength": 10
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "analysis_inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "official_candidates": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "ts_code",
          "name",
          "origin",
          "selection_order",
          "quant_score",
          "quant_rank",
          "technical_score",
          "input_snapshot",
          "selection_status",
          "final_order",
          "reason",
          "risk_notes",
          "next_day_action",
          "reorder"
        ],
        "properties": {
          "ts_code": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SH|SZ)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "official_pool",
              "external_pool"
            ]
          },
          "selection_order": {
            "type": "integer",
            "minimum": 1
          },
          "quant_score": {
            "type": "number"
          },
          "quant_rank": {
            "type": "integer",
            "minimum": 1
          },
          "technical_score": {
            "type": "number",
            "minimum": 18
          },
          "input_snapshot": {
            "type": "object"
          },
          "selection_status": {
            "enum": [
              "selected",
              "watch",
              "deferred"
            ]
          },
          "final_order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "risk_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_day_action": {
            "type": "string",
            "minLength": 1
          },
          "reorder": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "from_selection_order",
              "to_final_order",
              "reason",
              "sources"
            ],
            "properties": {
              "from_selection_order": {
                "type": "integer"
              },
              "to_final_order": {
                "type": "integer"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "published_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "published_at": {
                      "type": "string",
                      "minLength": 10
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "external_candidates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "ts_code",
          "name",
          "origin",
          "selection_order",
          "quant_score",
          "quant_rank",
          "technical_score",
          "input_snapshot",
          "selection_status",
          "final_order",
          "reason",
          "risk_notes",
          "next_day_action",
          "reorder"
        ],
        "properties": {
          "ts_code": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SH|SZ)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "official_pool",
              "external_pool"
            ]
          },
          "selection_order": {
            "type": "integer",
            "minimum": 1
          },
          "quant_score": {
            "type": "number"
          },
          "quant_rank": {
            "type": "integer",
            "minimum": 1
          },
          "technical_score": {
            "type": "number",
            "minimum": 18
          },
          "input_snapshot": {
            "type": "object"
          },
          "selection_status": {
            "enum": [
              "selected",
              "watch",
              "deferred"
            ]
          },
          "final_order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "risk_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_day_action": {
            "type": "string",
            "minLength": 1
          },
          "reorder": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "from_selection_order",
              "to_final_order",
              "reason",
              "sources"
            ],
            "properties": {
              "from_selection_order": {
                "type": "integer"
              },
              "to_final_order": {
                "type": "integer"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "published_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "published_at": {
                      "type": "string",
                      "minLength": 10
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

